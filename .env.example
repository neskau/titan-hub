# Copie para .env.local (desenvolvimento) e cadastre os mesmos valores na Vercel (Settings > Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Integração Bling (API v3, OAuth) — preencher na Fase 1 quando o app for criado no Bling
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# Chave aleatória para proteger as rotas de sincronização agendada
CRON_SECRET=
